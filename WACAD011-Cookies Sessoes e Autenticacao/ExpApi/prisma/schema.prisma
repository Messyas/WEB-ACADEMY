// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

model Product {
  id   String @id @default(uuid()) @db.Char(36) //ocupa sempre o mesmo numero de bytes
  name String @unique @db.VarChar(100) //varia
  price Decimal @db.Decimal(10, 2) //10 digitos no total, 2 depois da virgula
  stockQuantity Int @db.Int()
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
