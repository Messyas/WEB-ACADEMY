{{! src/views/products/show.handlebars }}

{{#if product}}
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Detalhes do Produto: {{product.name}}</h1>
    <a href="/products" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left-square"></i> Voltar para Lista
    </a>
  </div>

  <div class="card">
    <div class="card-body">
      <h5 class="card-title">{{product.name}}</h5>
      <p class="card-text"><strong>ID:</strong> {{product.id}}</p>
      <p class="card-text"><strong>Preço:</strong> R$ {{product.price}}</p>
      <p class="card-text"><strong>Estoque:</strong> {{product.stock}} unidades</p>
    </div>
    <div class="card-footer">
      <a href="/products/update/{{product.id}}" class="btn btn-primary me-2">
        <i class="bi bi-pencil-fill"></i> Editar
      </a>
      <a href="/products/remove/{{product.id}}" class="btn btn-danger" onclick="return confirm('Tem certeza que deseja remover este produto?');">
        <i class="bi bi-trash"></i> Remover
      </a>
    </div>
  </div>
{{else}}
  <div class="alert alert-warning" role="alert">
    Produto não encontrado.
  </div>
  <a href="/products" class="btn btn-primary">Voltar para Lista</a>
{{/if}}